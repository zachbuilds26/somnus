# Somnus backend environment
# Copy to backend/.env. NEVER commit real keys.

# --- Network ---------------------------------------------------------------
# testnet = Shannon (chain 50312) — ALWAYS use this during development
# mainnet = chain 5031
NETWORK=testnet

# --- Endpoint overrides (optional; sane per-network defaults are built in) ---
# REST_URL    DreamDEX HTTP API. SPOT/PERP ONLY — it has no event-contract routes.
#             testnet https://stg.api.dreamdex.io/v0
# INDEXER_URL The markets-SDK GraphQL (Envio/Hasura) endpoint used to discover
#             Event Contracts. MUST be the /v1/graphql URL, not the REST base —
#             pointing this at REST fails with "indexer RegistryMarkets failed".
#             testnet https://dev.smk.somnia.host/v1/graphql
#             mainnet https://prd.smk.somnia.host/v1/graphql
# WS_RPC_URL  Somnia chain WebSocket for the SDK's live tail.
#             testnet wss://api.infra.testnet.somnia.network/ws
REST_URL=
INDEXER_URL=
WS_RPC_URL=

# --- Server ----------------------------------------------------------------
PORT=4545
# Optional: require this token on /api/* requests (X-API-Key)
SOMNUS_API_KEY=

# --- Agent executor (SAFETY) ------------------------------------------------
# true (default) = the broker logs every order and SENDS NOTHING.
# Set to false ONLY when you are ready to send real testnet orders.
DRY_RUN=true

# --- Keys (optional, needed only for live EXECUTION) -------------------------
# Reads (markets, order books, agent dry-run cycles) need NO key at all.
# Dedicated bot wallet private key — for DEV/testnet only.
# NEVER use a wallet holding real funds. Prefer TRADE_KEY when available.
PRIVATE_KEY=

# Session-key mode (preferred): operator key signs, trade key can't withdraw.
# TRADE_KEY is used first when present.
OPERATOR_KEY=
TRADE_KEY=

# --- Venue (Event Contracts) ------------------------------------------------
# Optional. One deployment hosts several venues intermixed in the indexer;
# set this to scope the agent to one. Unset = read every venue.
# Read venueId off a live market row if you need it.
VENUE_ID=

# --- Logging / agent ---------------------------------------------------------
# NOTE: these SEED the defaults. Once you save rules via PUT /api/agent/config
# (or Agent Studio), backend/data/agent-config.json wins — that saved document
# is what the broker actually enforces.
LOG_LEVEL=info

# Start the autonomous loop on boot. OFF by default: a process that begins
# trading the moment it starts is the wrong default for one holding a key.
# Control it at runtime via POST /api/agent/loop/start|stop instead.
AGENT_AUTOSTART=false

# Minimum seconds a window must have left before the agent will trade it.
# A cycle takes tens of seconds, so a near-expiry window locks mid-flight and
# the pool reverts TradingNotActive (gas spent, no position).
AGENT_MIN_EXPIRY_SEC=75

# --- Exposure / access control ------------------------------------------------
# Browser origins allowed to call the API. NOT wildcard by default: this process
# can hold a funded key and exposes "start trading" as a POST, so any page you
# visited could otherwise arm a live agent on localhost. Comma-separated; `*`
# only if you mean it.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_INTERVAL_MS=60000
AGENT_MIN_EDGE=0.03
AGENT_MAX_TRADE_SIZE=25
AGENT_MAX_OPEN_POSITIONS=3
AGENT_SYMBOLS=BTC,ETH
AGENT_MODE=dry-run

# Total collateral allowed to sit in positions that have not settled yet.
# Defaults to AGENT_MAX_DAILY_LOSS: never have more riding at once than you would
# accept losing in a whole day.
#
# This is the gap the daily-loss limit cannot close. A binary only realises a loss
# when its window settles, so a batch of orders placed inside one interval is
# invisible to a daily-loss breaker until every one of them has resolved. Observed
# 2026-08-30: four ~$1000 orders went out in five minutes and all settled together
# 30 minutes later — $4000 at risk under a $1000 daily limit that had nothing to
# read. AGENT_MAX_OPEN_POSITIONS does not help either; it counts positions, not
# dollars. 0 disables the ceiling.
AGENT_MAX_OPEN_NOTIONAL=

# --- Risk: bounding a losing WEEK, not just a losing day ----------------------
# Realised loss from the equity PEAK before the agent pauses itself. 0 = off,
# which is the default: a drawdown ceiling computed over an existing ledger can
# halt an agent the moment it boots, on losses nobody opted into bounding.
# maxDailyLoss resets at UTC midnight, so an agent bleeding just under it every
# day never trips a breaker. This is the limit that notices.
AGENT_MAX_DRAWDOWN=0

# Per-trade cap as a FRACTION of equity (collateral + open cost), e.g. 0.02 = 2%.
# 0 = off. An absolute cap does not scale: $5 is 1% of a $500 account and 10% of
# the same account after a 90% loss. Whichever of this and AGENT_MAX_TRADE_SIZE
# is smaller binds.
AGENT_MAX_TRADE_PCT_EQUITY=0

# --- Risk: correlated exposure -------------------------------------------------
# AGENT_MAX_PER_EXPIRY limits positions sharing ONE expiry timestamp. BTC-UP-1230
# and ETH-UP-1230 resolve on the same tick against assets that move together, so
# "10 open positions" can be ten tickets on one macro view that win or lose as a
# block. AGENT_MAX_SAME_DIRECTION limits concurrent positions on one side, since a
# model with a directional bias fills the book and calls it diversification.
AGENT_MAX_PER_EXPIRY=2
AGENT_MAX_SAME_DIRECTION=0

# Oldest a settlement sweep may be before the agent refuses to open new risk.
# The loss breakers are computed from the P&L ledger, and only a sweep writes
# settled outcomes into it — if sweeps stop, those limits read a number that
# stopped moving rather than a flat day. Only enforced while positions are open.
AGENT_MAX_SETTLEMENT_AGE_MS=1800000

# --- Alerting ------------------------------------------------------------------
# Any endpoint that accepts a JSON POST (Slack, Discord, ntfy, a Lambda). Fired on
# a breaker trip, a loop halt, a total feed blackout, a failed settlement sweep,
# clock skew, and unrecorded on-chain positions. Left unset, breakers still work —
# they just work silently, which for an overnight agent means you find out in the
# morning.
ALERT_WEBHOOK_URL=
# Suppress a repeat of the SAME incident inside this window (default 15 min). A
# tripped breaker is re-evaluated every cycle; without dedupe one incident becomes
# a message a minute and the channel gets muted.
ALERT_DEDUPE_MS=900000

# --- Runtime safety ------------------------------------------------------------
# Seconds of host-vs-chain clock skew tolerated. Every expiry decision is
# arithmetic on the local clock against on-chain seconds, so drift silently makes
# the agent trade locked windows or mis-price the ones it takes.
AGENT_CLOCK_SKEW_WARN_SEC=10
AGENT_CLOCK_SKEW_BLOCK_SEC=45
# How long shutdown waits for an in-flight cycle before exiting. Killing the
# process between a fill landing on-chain and its ledger write leaves a position
# nothing local knows about.
SHUTDOWN_GRACE_MS=30000
# Reconcile chain state against the ledger every N cycles.
AGENT_RECONCILE_EVERY_CYCLES=30
