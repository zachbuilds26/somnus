{
  "name": "@somnus/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Somnus backend: governed, auditable trading agent runtime for DreamDEX Event Contracts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
